rules_version = '2';

// The friends' cup (see src/ui/friendCupApi.ts). No accounts: devices are known by a random id.
// A cup can be made and joined; its code and host never change and its round count only goes up.
// A team can only be sent by a member of the cup, and a round played can never be changed.
// Nothing is ever deleted.
service cloud.firestore {
  match /databases/{database}/documents {
    match /cups/{code} {
      allow read: if true;
      allow create: if code.size() == 6
        && request.resource.data.code == code
        && request.resource.data.round == 0
        && request.resource.data.creator is string
        && request.resource.data.members is map
        && request.resource.data.members.size() == 1;
      allow update: if request.resource.data.code == resource.data.code
        && request.resource.data.creator == resource.data.creator
        && request.resource.data.seed == resource.data.seed
        && request.resource.data.round >= resource.data.round
        && request.resource.data.members.size() <= 16;
      allow delete: if false;

      match /teams/{member} {
        allow read: if true;
        allow create, update: if member in get(/databases/$(database)/documents/cups/$(code)).data.members
          && request.resource.data.json is string
          && request.resource.data.json.size() < 500000;
        allow delete: if false;
      }

      match /rounds/{round} {
        allow read: if true;
        allow create: if request.resource.data.results is list;
        allow update, delete: if false;
      }
    }
  }
}
