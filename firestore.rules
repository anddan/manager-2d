rules_version = '2';

// The friends' cup (see src/ui/friendCupApi.ts). No accounts: devices are known by a random id.
// A cup can be made and joined; its code never changes and its round count only goes up. The
// host only changes when they leave. A team can only be sent by a member of the cup, and a round
// played can never be changed. When everyone has left, the cup and all in it may be cleared away.
service cloud.firestore {
  match /databases/{database}/documents {
    // No one is in the cup any more: no members, or every member has left.
    function deserted(cup) {
      return cup.members.size() == 0
        || (cup.get('left', []) is list && cup.get('left', []).toSet().hasAll(cup.members.keys()));
    }

    function cupAt(code) {
      return get(/databases/$(database)/documents/cups/$(code)).data;
    }

    // Friends: each device's profile (friend code, club, team as sent). The code never changes;
    // the team is size-bounded; friends are added and removed both ways. Only a friendless one can go.
    match /profiles/{device} {
      allow read: if true;
      allow create: if request.resource.data.friendCode is string
        && request.resource.data.friendCode.size() == 6
        && request.resource.data.team is string
        && request.resource.data.team.size() < 500000;
      allow update: if request.resource.data.friendCode == resource.data.friendCode
        && request.resource.data.team is string
        && request.resource.data.team.size() < 500000
        && request.resource.data.get('friends', {}).size() <= 100;
      allow delete: if resource.data.get('friends', {}).size() == 0;
    }

    // Trades between friends: made open, then only accepted, declined or withdrawn, once.
    match /trades/{offer} {
      allow read: if true;
      allow create: if request.resource.data.from is string
        && request.resource.data.to is string
        && request.resource.data.from != request.resource.data.to
        && request.resource.data.status == 'open'
        && request.resource.data.price is number
        && request.resource.data.price >= 0
        && request.resource.data.get('swap', '').size() < 200000;
      allow update: if resource.data.status == 'open'
        && request.resource.data.status in ['accepted', 'declined', 'cancelled']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'player'])
        && request.resource.data.get('player', '').size() < 200000;
      allow delete: if resource.data.status != 'open';
    }

    // A player sold with a code: put up open, then bought or taken back once; cleared when done.
    match /sales/{code} {
      allow read: if true;
      allow create: if code.size() == 6
        && request.resource.data.code == code
        && request.resource.data.status == 'open'
        && request.resource.data.seller is string
        && request.resource.data.price is number
        && request.resource.data.price >= 0
        && request.resource.data.player is string
        && request.resource.data.player.size() < 200000;
      allow update: if resource.data.status == 'open'
        && request.resource.data.status in ['sold', 'cancelled']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'buyer']);
      allow delete: if resource.data.status != 'open';
    }

    match /cups/{code} {
      allow read: if true;
      allow create: if code.size() == 6
        && request.resource.data.code == code
        && request.resource.data.round == 0
        && request.resource.data.creator is string
        && request.resource.data.members is map
        && request.resource.data.members.size() == 1;
      allow update: if request.resource.data.code == resource.data.code
        && (request.resource.data.creator == resource.data.creator
          || !(resource.data.creator in request.resource.data.members)
          || resource.data.creator in request.resource.data.get('left', []))
        && request.resource.data.seed == resource.data.seed
        && request.resource.data.round >= resource.data.round
        && request.resource.data.members.size() <= 16
        // A prize taken stays taken, and a pack opened stays opened.
        && (!('prizeClaimed' in resource.data) || request.resource.data.get('prizeClaimed', null) == resource.data.prizeClaimed)
        && (!('packsTaken' in resource.data) || request.resource.data.get('packsTaken', {}).keys().hasAll(resource.data.packsTaken.keys()));
      allow delete: if deserted(resource.data);

      match /teams/{member} {
        allow read: if true;
        allow create, update: if member in cupAt(code).members
          && request.resource.data.json is string
          && request.resource.data.json.size() < 500000;
        allow delete: if !(member in cupAt(code).members) || deserted(cupAt(code));
      }

      // Trades between members: made open, then only accepted, declined or withdrawn, once.
      match /offers/{offer} {
        allow read: if true;
        allow create: if request.resource.data.from in cupAt(code).members
          && request.resource.data.to in cupAt(code).members
          && request.resource.data.from != request.resource.data.to
          && request.resource.data.status == 'open'
          && request.resource.data.price is number
          && request.resource.data.price >= 0
          && request.resource.data.get('swap', '').size() < 200000;
        allow update: if resource.data.status == 'open'
          && request.resource.data.status in ['accepted', 'declined', 'cancelled']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'player'])
          && request.resource.data.get('player', '').size() < 200000;
        allow delete: if deserted(cupAt(code));
      }

      match /rounds/{round} {
        allow read: if true;
        allow create: if request.resource.data.results is list;
        allow update: if false;
        allow delete: if deserted(cupAt(code));
      }
    }
  }
}
